# ─────────────────────────────────────────────
# COMPANION DISEASE RISK AI — Environment Config
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ── General ──────────────────────────────────
NODE_ENV=development
PORT=3000

# ── GCP / Firebase ───────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# ── MongoDB Atlas ─────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/companion-ai
MONGODB_DB_NAME=companion_ai

# ── Node.js Services ─────────────────────────
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
PET_SERVICE_PORT=4002
CLINIC_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004
VACCINATION_SERVICE_PORT=4005
ADMIN_SERVICE_PORT=4006
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY=7d
AUTH_SERVICE_URL=http://localhost:4001
PET_SERVICE_URL=http://localhost:4002
CLINIC_SERVICE_URL=http://localhost:4003
NOTIFICATION_SERVICE_URL=http://localhost:4004
VACCINATION_SERVICE_URL=http://localhost:4005
ADMIN_SERVICE_URL=http://localhost:4006
FRONTEND_BASE_URL=http://localhost:3001

# ── Python AI Service ─────────────────────────
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001

# ── Python Agent Service ──────────────────────
AGENT_SERVICE_PORT=8002
AGENT_SERVICE_URL=http://localhost:8002

# ── Google Gemini (Agentic AI layer) ──────────
# Leave empty to run agents in deterministic rule-based fallback mode
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Demo data ─────────────────────────────────
# Insert demo clinics/surgeons/slots on clinic-service startup. These are
# invented records, so this is opt-in: the platform starts empty and clinics are
# created through the admin UI. Set true for a quick demo setup (booking, clinic
# map and the agent's clinic recommendation all need at least one clinic).
SEED_DEMO_DATA=false

# ── Autonomous monitoring agent ───────────────
MONITOR_INTERVAL_MINUTES=360
# Optional: run the preventive-care sweep daily at a fixed time instead (paper spec)
MONITOR_DAILY_AT=08:00

# ── Service-to-service auth ───────────────────
SERVICE_KEY=internal-dev-key
# Flip to true to enforce JWT auth at the API gateway
AUTH_ENFORCE=false

# ── Vertex AI ─────────────────────────────────
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL_ENDPOINT=your-vertex-endpoint-id

# ── LangChain / LangSmith ─────────────────────
LANGCHAIN_API_KEY=your-langchain-api-key
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=companion-disease-risk-ai
LANGCHAIN_TRACING_V2=true

# ── Neo4j Ontology ────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
# Community edition supports only the default "neo4j" database
NEO4J_DATABASE=neo4j

# ── Google Maps ───────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Firebase Cloud Messaging ──────────────────
FCM_SERVER_KEY=your-fcm-server-key

# ── Frontend (Vite) ───────────────────────────
VITE_API_GATEWAY_URL=http://localhost:4000
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# By default point frontends to the API gateway for local dev
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
VITE_PET_SERVICE_URL=http://localhost:4000
VITE_CLINIC_SERVICE_URL=http://localhost:4000
VITE_VACCINATION_SERVICE_URL=http://localhost:4000
VITE_AI_SERVICE_URL=http://localhost:4000
VITE_AGENT_SERVICE_URL=http://localhost:4000
